# Copy to backend/.env and fill in. Never commit the real values.

# The Claude brain. Required for the server to boot.
# To run with the mocked brain instead, set BIGBROS_USE_MOCK_BRAIN=1 and leave this blank.
ANTHROPIC_API_KEY=

# ElevenLabs, for Scribe transcription and TTS. Needed on first tablet use.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# D-ID streaming avatar. Needed on first tablet use.
DID_API_KEY=
# Optional. The presenter image for the host. Falls back to a D-ID default if unset.
DID_AVATAR_IMAGE_URL=

# ---- Auth (required in deployment; the server refuses to boot without them) ----

# Shared staff key. Gates the dashboard websocket, ticket status flips,
# /rooms, and the typed /turn path. Generate with: openssl rand -hex 24
BIGBROS_STAFF_KEY=

# Device tokens, one per tablet, format token:room comma-separated.
# The token IS the room identity; a tablet can never claim another suite.
# Provision a tablet by opening /tablet?token=THETOKEN once on the device.
# Example: BIGBROS_DEVICE_TOKENS=a1b2c3d4:4,e5f6a7b8:honeymoon
BIGBROS_DEVICE_TOKENS=

# Comma-separated frontend origins for CORS. Set to the real Netlify URL(s)
# in production. Defaults to localhost dev ports if unset.
BIGBROS_CORS_ORIGINS=

# Local development only: skip all auth. NEVER set this on a deployed backend.
# BIGBROS_DEV_OPEN=1

# ---- KUYA guest sync (the booking-to-room handoff) ----
# Base URL of the KUYA backend. Empty disables the sync entirely.
KUYA_BASE_URL=
# Matches SERVICE_API_KEY on the KUYA backend.
KUYA_SERVICE_KEY=
# Auto-pull cadence in seconds (default 10800, every 3 hours). 0 disables the
# timer; the dashboard refresh button still works.
BIGBROS_KUYA_SYNC_SECONDS=10800

# Demo personas (Korean family with shellfish allergy, anniversary couple).
# Rooms start blank without this; real context comes from the KUYA sync.
# BIGBROS_DEMO_SEED=1

# ---- Observability ----
# Log verbosity: DEBUG, INFO (default), WARNING, ERROR.
BIGBROS_LOG_LEVEL=INFO
# Optional Sentry error reporting. Needs: pip install sentry-sdk
# SENTRY_DSN=
# Where the SQLite file lives. Default backend/data/bigbros.db.
# On Render: mount a persistent disk and use /data/bigbros.db
# BIGBROS_DB_PATH=

# ---- Avatar provider ----
# Simli is the production face (about 5 cents/min vs D-ID's dollar/min).
# Setting SIMLI_API_KEY auto-selects it; see SETUP.md section 4a.
SIMLI_API_KEY=
# Create a face at app.simli.com by uploading the host photo.
SIMLI_FACE_ID=
# Force a provider: simli | did. Usually unnecessary (auto-detected).
# BIGBROS_AVATAR_PROVIDER=simli
# The resting host photo on the tablet. Falls back to DID_AVATAR_IMAGE_URL.
# BIGBROS_AVATAR_IMAGE_URL=
