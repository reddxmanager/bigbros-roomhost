# Copy to backend/.env and fill in. Never commit the real values.

# The Claude brain. Required for the server to boot.
# To run with the mocked brain instead, set BIGBROS_USE_MOCK_BRAIN=1 and leave this blank.
ANTHROPIC_API_KEY=

# ElevenLabs, for Scribe transcription and TTS. Needed on first tablet use.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# D-ID streaming avatar. Needed on first tablet use.
DID_API_KEY=
# Optional. The presenter image for the host. Falls back to a D-ID default if unset.
DID_AVATAR_IMAGE_URL=
